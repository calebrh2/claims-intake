{
  "name": "claims-intake",
  "install": "curl -LsSf https://astral.sh/uv/install.sh | sh && . \"$HOME/.local/bin/env\" && uv sync --frozen",
  "terminals": [
    {
      "name": "api",
      "command": ". \"$HOME/.local/bin/env\" && uv run uvicorn claims.api.routes:app --host 0.0.0.0 --port 8000 --reload"
    }
  ],
  "ports": [{ "name": "api", "port": 8000 }]
}
